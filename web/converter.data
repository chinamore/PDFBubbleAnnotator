(function(){'use strict';function base(){return(window.sourceName||document.title||'document.pdf').replace(/\.[^.]+$/,'')}function dl(b,n){var u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=n;a.click();setTimeout(function(){URL.revokeObjectURL(u)},5000)}function busy(v){var e=document.getElementById('_busy');if(!e){e=document.createElement('div');e.id='_busy';e.style='position:fixed;inset:0;background:#0008;color:#fff;display:none;align-items:center;justify-content:center;z-index:99999;font-size:18px';e.textContent='Converting...';document.body.appendChild(e)}e.style.display=v?'flex':'none'}async function pageCanvas(d,n,s){var p=await d.getPage(n),v=p.getViewport({scale:s}),c=document.createElement('canvas'),x=c.getContext('2d');c.width=Math.ceil(v.width);c.height=Math.ceil(v.height);await p.render({canvasContext:x,viewport:v}).promise;return c}async function rows(d){var r=[];for(var i=1;i<=d.numPages;i++){var p=await d.getPage(i),t=await p.getTextContent();for(var j=0;j<(t.items||[]).length;j++){var z=t.items[j],s=(z.str||'').trim();if(s)r.push({Page:i,Text:s,X:Number(z.transform&&z.transform[4]||0).toFixed(2),Y:Number(z.transform&&z.transform[5]||0).toFixed(2),Width:Number(z.width||0).toFixed(2),Height:Number(z.height||0).toFixed(2)})}}return r}function init(){var tb=document.getElementById('toolbar');if(!tb||!window.pdfjsLib)return;var g=document.createElement('div');g.className='group';g.innerHTML='<button id="_img" style="background:#7c3aed">PDF→PNG</button><button id="_xls" style="background:#7c3aed">PDF→Excel</button><button id="_doc" style="background:#7c3aed">PDF→Word</button>';tb.appendChild(g);document.getElementById('_img').onclick=async function(){if(!window.pdf)return alert('Open a PDF first');if(!window.JSZip)return alert('JSZip not loaded');busy(1);try{var z=new JSZip(),b=base();for(var i=1;i<=pdf.numPages;i++){var c=await pageCanvas(pdf,i,2),blob=await new Promise(function(r){c.toBlob(r,'image/png')});z.file(b+'-page-'+String(i).padStart(3,'0')+'.png',blob)}dl(await z.generateAsync({type:'blob',compression:'DEFLATE'}),b+' - Images.zip')}catch(e){alert(e.message)}finally{busy(0)}};document.getElementById('_xls').onclick=async function(){if(!window.pdf)return alert('Open a PDF first');if(!window.XLSX)return alert('XLSX not loaded');busy(1);try{var r=await rows(pdf),w=XLSX.utils.book_new();XLSX.utils.book_append_sheet(w,XLSX.utils.json_to_sheet(r.length?r:[{Page:'',Text:''}]),'PDF Text');var a=window.ann||[];if(a.length)XLSX.utils.book_append_sheet(w,XLSX.utils.json_to_sheet(a.map(function(x){return{Page:x.page,Number:x.text,X:x.nx,Y:x.ny,Size:x.size,Border:x.border}})),'Bubbles');var o=XLSX.write(w,{bookType:'xlsx',type:'array'});dl(new Blob([o],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}),base()+' - Excel.xlsx')}catch(e){alert(e.message)}finally{busy(0)}};document.getElementById('_doc').onclick=async function(){if(!window.pdf)return alert('Open a PDF first');if(!window.docx)return alert('DOCX not loaded');busy(1);try{var r=await rows(pdf),D=window.docx,c=[];for(var p=1;p<=pdf.numPages;p++){c.push(new D.Paragraph({text:'Page '+p,heading:D.HeadingLevel.HEADING_1}));r.filter(function(x){return x.Page===p}).forEach(function(x){c.push(new D.Paragraph({text:x.Text}))})}var d=new D.Document({sections:[{children:c}]}),o=await D.Packer.toBlob(d);dl(o,base()+' - Word.docx')}catch(e){alert(e.message)}finally{busy(0)}}}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init()})();